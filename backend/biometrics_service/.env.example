# Biometrics Service Configuration
# Copy to .env and configure

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Model paths (relative to service root)
DETECTOR_MODEL=models/yunet_n_640_640.onnx
EMBEDDER_MODEL=models/w600k_r50.onnx

# Thresholds
QUALITY_MIN_FACE_SIZE=80
QUALITY_MIN_BRIGHTNESS=40
QUALITY_MAX_BRIGHTNESS=220
QUALITY_MAX_BLUR=100
DETECTION_CONFIDENCE=0.7
MATCH_THRESHOLD=0.45
LIVENESS_MIN_FRAMES=5

# Database (for storing embeddings)
DATABASE_URL=postgresql://watchguard:yourpassword@localhost:5432/watchguard

# Storage (optional file-based backup)
EMBEDDINGS_DIR=./embeddings
